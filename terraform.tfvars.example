# ─────────────────────────────────────────────────────────────────────────────
# Hermes Agent on GCP Cloud Run -- Example Variables
#
# Copy this file to terraform.tfvars and fill in your values.
# SECURITY: Never commit terraform.tfvars to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Required -- your GCP project ID
project_id = "my-project-id"

# Region for Cloud Run and Artifact Registry
region = "us-central1"

# Vertex AI endpoint region ("global" recommended for widest model availability)
vertex_location = "global"

# Default model for Hermes Agent
hermes_default_model = "gemini-2.5-flash"

# Model aliases (short name -> Vertex AI model ID)
vertex_model_aliases = {
  "gemini-2.5-flash"             = "gemini-2.5-flash"
  "gemini-2.5-pro".              = "gemini-2.5-pro"
}

# Developers -- each gets a dedicated Cloud Run service and GCS workspace bucket
developers = {
  "dev1" = { active = true }
}

# Cloud Run execution environment: "gen2" (recommended, required for GCS FUSE) or "gen1"
execution_environment = "gen2"

# Monitoring (optional -- leave empty to skip alert creation)
alert_email = ""

# Deployer SA for IAP tunnel access (optional -- leave empty to skip)
deployer_service_account = ""
