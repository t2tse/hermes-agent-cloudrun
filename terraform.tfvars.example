# ─────────────────────────────────────────────────────────────────────────────
# Hermes Agent on GCP -- Example Variables
#
# Copy this file to terraform.tfvars and fill in your values.
# SECURITY: Never commit terraform.tfvars to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Required -- your GCP project ID
project_id = "my-project-id"

# Region for GKE cluster and Artifact Registry
region          = "us-central1"

# Vertex AI endpoint region ("global" recommended for widest model availability)
vertex_location = "global"

# Default model for Hermes Agent
hermes_default_model = "gemini-2.5-flash"

# Model aliases (short name -> Vertex AI model ID)
vertex_model_aliases = {
  "gemini-2.5-flash" = "gemini-2.5-flash"
  "gemini-2.5-pro"   = "gemini-2.5-pro-preview-06-05"
}

# Developers -- each gets a dedicated Hermes Agent pod and 10Gi PVC
developers = {
  "dev1" = { active = true }
}

# Master authorized networks (CIDRs allowed to access GKE control plane)
master_authorized_cidrs = {
  "My IP" = "YOUR_IP/32"
}

# Monitoring (optional -- leave empty to skip alert creation)
alert_email = ""
