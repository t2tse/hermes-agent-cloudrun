# Hermes Agent configuration -- deployed via Terraform
# Vertex AI models are accessed through the local proxy (port 8081)
# which handles ADC/Workload Identity token injection.

model:
  default: "custom:vertex-ai:${HERMES_DEFAULT_MODEL}"

custom_providers:
  - name: "vertex-ai"
    base_url: "http://127.0.0.1:8081/v1"

terminal:
  backend: "local"
  cwd: "/opt/data/workspace"
  timeout: 180

compression:
  enabled: true
  strategy: "summary"

browser:
  inactivity_timeout: 30

smart_model_routing:
  enabled: false

security:
  tirith:
    enabled: false
