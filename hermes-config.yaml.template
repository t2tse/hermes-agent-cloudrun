# Hermes Agent configuration -- deployed via Terraform
# Vertex AI models are accessed through the local proxy (port 8081)
# which handles ADC/Workload Identity token injection.

model:
  provider: "custom"
  default: "${HERMES_DEFAULT_MODEL}"
  base_url: "http://127.0.0.1:8081/v1"
  api_key: "not-needed-proxy-handles-auth"

terminal:
  backend: "local"
  cwd: "/opt/data/workspace"
  timeout: 180

# Dangerous command approval -- always require human confirmation
approvals:
  mode: "manual"
  timeout: 60

compression:
  enabled: true
  strategy: "summary"

browser:
  inactivity_timeout: 30

smart_model_routing:
  enabled: false

# Security hardening
security:
  # Tirith pre-exec scanning: detects homograph URLs, pipe-to-shell,
  # terminal injection attacks before command execution
  tirith:
    enabled: true
    fail_open: false

  # Block access to GCP metadata and internal services
  website_blocklist:
    enabled: true
    domains:
      - "metadata.google.internal"
      - "metadata.goog"
      - "169.254.169.254"
      - "*.internal"
